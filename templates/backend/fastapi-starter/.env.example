# APP_ENV is shared with Nest (NODE_ENV is accepted only as a compatibility alias).
# APP_ENV=production fails closed unless the secret, explicit CORS origins and email adapter are configured.
APP_ENV=development
# Use a long, random SECRET_KEY outside development.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE_SSL=false
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=fastapi-starter
JWT_AUDIENCE=fastapi-starter-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Browser sessions keep the refresh credential outside JSON. In production use
# COOKIE_SECURE=true; SameSite=None is valid only when Secure is also true.
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins. Never use * when credentials are enabled.
CORS_ORIGINS=http://localhost:3000
# Cross-worker application limiter. Production/staging requires a TLS Redis URL (rediss://).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Login, registration, and each password-recovery operation get independent stricter buckets.
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PREFIX=rate-limit
REDIS_URL=redis://localhost:6379
# Trust X-Forwarded-* only from explicit reverse-proxy IPs.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
# OAuth authorization-code + PKCE. The callback is served by this backend and
# writes the refresh token only as an HttpOnly cookie before redirecting home.
OAUTH_ENABLED=false
OAUTH_CALLBACK_BASE_URL=http://localhost:8000
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
OAUTH_GOOGLE_SCOPES=openid email profile
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:8000/auth/oauth/github/callback
OAUTH_GITHUB_SCOPES=read:user user:email
# Stripe Billing. A configured plan is an allowlist: browser clients can only
# purchase a listed price ID. Set secret key and webhook secret together.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLANS={"price_example":{"name":"pro","entitlements":{"api_calls":10000,"team_members":10}}}
BILLING_FREE_ENTITLEMENTS={"api_calls":100}
# Optional: restrict Portal to a specific Stripe Billing Portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional Stripe meter event name. Usage is accepted only from trusted server code.
STRIPE_USAGE_EVENT_NAME=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Authenticated transactional-email adapter. Staging/production requires an HTTPS URL and token.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
