# APP_ENV=production fails closed unless the secret, explicit CORS origins and SMTP are configured.
APP_ENV=development
# Use a long, random SECRET_KEY outside development.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Browser sessions keep the refresh credential outside JSON. In production use
# COOKIE_SECURE=true; SameSite=None is valid only when Secure is also true.
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins. Never use * when credentials are enabled.
CORS_ORIGINS=http://localhost:3000
# Optional app-side limiter. Use Redis/edge limiting for multi-instance production.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=
# Provider-neutral OAuth configuration (example provider name: GOOGLE).
OAUTH_ENABLED=false
OAUTH_CALLBACK_BASE_URL=http://localhost:8000
OAUTH_GOOGLE_AUTHORIZATION_URL=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_SCOPES=openid email profile
# Configure the provider webhook secret outside source control.
STRIPE_WEBHOOK_SECRET=
# Secure SMTP: production requires all of these. Port 587 uses STARTTLS; set SMTP_USE_SSL=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
