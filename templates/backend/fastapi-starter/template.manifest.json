{
  "$schema": "../../../docs/template-manifest.schema.json",
  "schemaVersion": 1,
  "id": "backend:fastapi",
  "version": "0.1.0",
  "kind": "backend",
  "displayName": "FastAPI starter",
  "description": "Modular FastAPI SaaS API with PostgreSQL, secure browser sessions, organizations, and billing domain models.",
  "runtime": {
    "language": "python",
    "version": ">=3.13",
    "packageManager": "uv"
  },
  "capabilities": [
    "auth.password",
    "auth.refresh-sessions",
    "auth.email-verification",
    "auth.password-recovery",
    "users.profile",
    "organizations",
    "organizations.rbac",
    "organizations.invitations",
    "billing.stripe",
    "oauth.pkce",
    "oauth.google",
    "oauth.github",
    "database.postgresql",
    "database.migrations",
    "security.csrf",
    "security.rate-limiting",
    "email.transactional"
  ],
  "development": {
    "port": 8000,
    "baseUrl": "http://localhost:8000"
  },
  "environment": {
    "required": [
      {
        "name": "DATABASE_URL",
        "secret": true,
        "description": "PostgreSQL connection URL."
      },
      {
        "name": "SECRET_KEY",
        "secret": true,
        "description": "Long random signing secret for JWTs and one-time tokens."
      },
      {
        "name": "FRONTEND_URL",
        "secret": false,
        "description": "Public URL of the selected frontend."
      },
      {
        "name": "CORS_ORIGINS",
        "secret": false,
        "description": "Comma-separated browser origins allowed to call the API."
      }
    ]
  }
}
