{
  "$schema": "../../../docs/template-manifest.schema.json",
  "schemaVersion": 1,
  "id": "backend:fastify",
  "version": "0.1.0",
  "kind": "backend",
  "displayName": "Fastify starter",
  "description": "Fastify TypeScript SaaS API with PostgreSQL-backed browser sessions, account recovery, email verification, Google and GitHub OAuth, CSRF protection, transactional email, and Redis-backed rate limiting.",
  "runtime": {
    "language": "node",
    "version": ">=20",
    "packageManager": "pnpm"
  },
  "capabilities": [
    "auth.password",
    "auth.refresh-sessions",
    "auth.email-verification",
    "auth.password-recovery",
    "users.profile",
    "oauth.pkce",
    "oauth.google",
    "oauth.github",
    "database.postgresql",
    "database.migrations",
    "security.csrf",
    "security.rate-limiting",
    "email.transactional"
  ],
  "development": {
    "port": 3002,
    "baseUrl": "http://localhost:3002"
  },
  "environment": {
    "required": [
      {
        "name": "DATABASE_URL",
        "secret": true,
        "description": "PostgreSQL connection URL."
      },
      {
        "name": "SECRET_KEY",
        "secret": true,
        "description": "Long random application secret."
      },
      {
        "name": "FRONTEND_URL",
        "secret": false,
        "description": "Public URL of the selected frontend."
      },
      {
        "name": "CORS_ORIGINS",
        "secret": false,
        "description": "Comma-separated browser origins allowed to call the API."
      }
    ]
  }
}
