# APP_ENV is shared with the other backend starters. NODE_ENV remains accepted.
APP_ENV=development
PORT=3002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastify_starter
DATABASE_SSL=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Use a long random value. It is reserved for signed integrations and future token encryption.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
# Must be true in production. COOKIE_SAME_SITE=none also requires it.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Transactional-email HTTPS adapter. Required in staging/production; leave empty for local development.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
# Shared distributed request limiter. Production/staging requires rediss://;
# development may fall back to an in-process limiter when Redis is unavailable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Login, registration, and each password-recovery operation get independent stricter buckets.
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PREFIX=rate-limit
REDIS_URL=redis://localhost:6379
# Trust X-Forwarded-* only when the immediate peer is an explicit proxy IP.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
# Google and GitHub use authorization-code OAuth with PKCE. Register the callback
# URLs below at each provider before setting OAUTH_ENABLED=true.
OAUTH_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3002/auth/oauth/google/callback
OAUTH_GOOGLE_SCOPES=openid email profile
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
OAUTH_GITHUB_USERINFO_URL=https://api.github.com/user
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3002/auth/oauth/github/callback
OAUTH_GITHUB_SCOPES=read:user user:email
