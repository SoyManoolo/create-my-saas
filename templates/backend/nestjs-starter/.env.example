# APP_ENV is shared with FastAPI. NODE_ENV remains accepted for existing deployments.
APP_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_starter
DATABASE_SSL=false
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# HTTPS endpoint of an authenticated transactional-email adapter. Required in production/staging.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
JWT_ALGORITHM=HS256
JWT_ISSUER=nestjs-starter
JWT_AUDIENCE=nestjs-starter-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Browser refresh credential: never expose it in JSON. Set COOKIE_SECURE=true in production.
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Login, registration, and each password-recovery operation get independent stricter buckets.
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PREFIX=rate-limit
RATE_LIMIT_ENABLED=true
# Production/staging requires rediss:// so limiter traffic is encrypted.
REDIS_URL=redis://localhost:6379
# Trust X-Forwarded-* only from explicit reverse-proxy IPs.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
# OAuth callbacks terminate on the API: refresh is set in an HttpOnly cookie
# and the browser is then redirected to FRONTEND_URL/auth/oauth/callback.
OAUTH_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3001/auth/oauth/google/callback
OAUTH_GOOGLE_SCOPES=openid email profile
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
OAUTH_GITHUB_USERINFO_URL=https://api.github.com/user
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3001/auth/oauth/github/callback
OAUTH_GITHUB_SCOPES=read:user user:email
# Stripe is optional. With no credentials the authenticated checkout/portal
# endpoints return configured=false and no URL. Configure price IDs server-side;
# do not accept arbitrary prices from the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PORTAL_CONFIGURATION_ID=
# Price IDs are mapped to local plans and limits. null means an enabled,
# unlimited entitlement. Use the same event name configured in Stripe Billing.
STRIPE_PRICE_PLANS={"price_pro_monthly":{"name":"pro","entitlements":{"api_requests":10000,"projects":25}}}
BILLING_FREE_ENTITLEMENTS={"api_requests":100,"projects":1}
STRIPE_USAGE_EVENT_NAME=
