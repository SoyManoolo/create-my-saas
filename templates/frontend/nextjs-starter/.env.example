# Server-only origin used by the Next.js same-origin proxy.
# Nest: set PORT=3001 in templates/backend/nestjs-starter/.env.
# FastAPI: http://localhost:8000.
API_PROXY_TARGET=http://localhost:3001

# Keep blank when the proxy above is used. Set it only if a reverse proxy maps
# these endpoints to the same browser origin as this app.
NEXT_PUBLIC_API_BASE_URL=

# Keep these in sync with the backend cookie configuration when names change.
NEXT_PUBLIC_CSRF_COOKIE_NAME=csrf_token
