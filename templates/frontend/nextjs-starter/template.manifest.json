{
  "schemaVersion": 1,
  "id": "frontend:nextjs",
  "kind": "frontend",
  "version": "0.1.0",
  "displayName": "Next.js SaaS starter",
  "description": "A reusable Next.js frontend with browser authentication and protected routes.",
  "runtime": {
    "language": "TypeScript",
    "version": ">=20.9.0",
    "packageManager": "pnpm@11.11.0"
  },
  "capabilities": [
    "auth.browser-sessions",
    "auth.csrf",
    "auth.password-recovery",
    "auth.email-verification",
    "auth.protected-routes",
    "oauth.pkce",
    "oauth.google",
    "oauth.github",
    "billing.stripe"
  ],
  "compatibility": {
    "requiresBackendCapabilities": [
      "auth.password",
      "auth.refresh-sessions",
      "auth.email-verification",
      "auth.password-recovery",
      "users.profile",
      "security.csrf",
      "oauth.pkce",
      "oauth.google",
      "oauth.github",
      "organizations",
      "billing.stripe"
    ]
  },
  "environment": {
    "required": [
      {
        "name": "API_PROXY_TARGET",
        "secret": false,
        "description": "Server-only origin for the selected backend API."
      }
    ]
  }
}
