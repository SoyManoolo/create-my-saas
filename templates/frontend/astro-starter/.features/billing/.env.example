# Public canonical URL used by metadata and sitemap generation.
PUBLIC_SITE_URL=https://example.com

# Server-only API target used by the Astro development proxy. The generator
# fills it when an API backend is selected.
API_PROXY_TARGET=

# Same-origin API path or public gateway that forwards /auth, /users,
# /organizations and /billing. Keep
# browser auth on the same site in production so the HttpOnly refresh cookie
# and CSRF cookie have the expected scope.
PUBLIC_API_BASE_URL=
PUBLIC_CSRF_COOKIE_NAME=csrf_token
