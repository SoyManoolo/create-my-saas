{
  "schemaVersion": 1,
  "id": "frontend:astro",
  "kind": "frontend",
  "version": "0.2.0",
  "displayName": "Astro public site starter",
  "description": "An Astro starter with a public site plus real browser authentication and a protected product area.",
  "runtime": {
    "language": "TypeScript",
    "version": ">=20.9.0",
    "packageManager": "pnpm@11.11.0"
  },
  "capabilities": [
    "content.blog",
    "content.documentation",
    "marketing.landing-page",
    "seo.metadata",
    "seo.robots",
    "seo.sitemap",
    "ui.interactive-islands",
    "analytics.product",
    "analytics.consent",
    "auth.browser-sessions",
    "auth.csrf",
    "auth.password-recovery",
    "auth.email-verification",
    "auth.protected-routes",
    "oauth.pkce",
    "oauth.google",
    "oauth.github"
  ],
  "compatibility": {
    "requiresBackendCapabilities": [
      "auth.password",
      "auth.refresh-sessions",
      "auth.email-verification",
      "auth.password-recovery",
      "users.profile",
      "security.csrf",
      "oauth.pkce",
      "oauth.google",
      "oauth.github"
    ]
  },
  "features": [
    {
      "id": "billing",
      "description": "Organization-scoped Stripe billing, Checkout, and Customer Portal.",
      "capabilities": [
        "billing.stripe"
      ],
      "requiresBackendCapabilities": [
        "organizations",
        "billing.stripe"
      ]
    }
  ],
  "environment": {
    "required": [
      {
        "name": "PUBLIC_SITE_URL",
        "secret": false,
        "description": "Canonical public URL used when building metadata and the sitemap."
      }
    ]
  }
}
