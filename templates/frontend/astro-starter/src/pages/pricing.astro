---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pricing — LaunchKit" description="Straightforward example SaaS pricing page.">
  <section class="content">
    <p class="eyebrow">Pricing</p>
    <h1>Simple plans, clear value.</h1>
    <div class="card-grid">
      <article class="card"><h2>Starter</h2><p><strong>€0</strong> / month</p><p>For a first project and early validation.</p></article>
      <article class="card"><h2>Growth</h2><p><strong>€29</strong> / month</p><p>For teams ready to collaborate and scale.</p></article>
      <article class="card"><h2>Scale</h2><p>Let's talk</p><p>For bespoke compliance, support, and volume.</p></article>
    </div>
  </section>
</BaseLayout>
