---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  protected?: boolean;
}

const { title, description, protected: protectedPage = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body data-protected={protectedPage ? '' : undefined}>
    <header class="site-header">
      <a class="brand" href="/" aria-label="LaunchKit home">LaunchKit</a>
      <button class="menu-button" type="button" data-mobile-menu-button aria-controls="main-navigation">Menú</button>
      <nav id="main-navigation" data-mobile-menu aria-label="Main navigation">
        <a href="/pricing">Pricing</a>
        <a href="/docs">Docs</a>
        <a href="/blog">Blog</a>
        {protectedPage ? <><a href="/app/">Espacio</a><a href="/account/">Cuenta</a><button type="button" class="text-button" data-logout>Cerrar sesión</button></> : <><a href="/login/">Entrar</a><a class="nav-button" href="/register/">Crear cuenta</a></>}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} LaunchKit</span>
      <a href="/docs">Documentation</a>
      <a href="/blog">Blog</a>
    </footer>
    <script>
      import '../scripts/auth';
    </script>
  </body>
</html>
