<form class="contact-form" data-contact-form novalidate>
  <label>
    Work email
    <input name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
  </label>
  <label>
    What are you building?
    <textarea name="message" required rows="3" placeholder="Tell us a little about it"></textarea>
  </label>
  <button type="submit">Request access</button>
  <p class="form-status" data-form-status aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Replace this with a server endpoint or a form provider when the project needs lead capture.
    if (status) status.textContent = 'Thanks — we will be in touch shortly.';
    form.reset();
  });
</script>
