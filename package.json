{
  "name": "@soymanolo/create-my-saas",
  "version": "1.1.0",
  "description": "Generate a SaaS project from versioned backend and frontend starter templates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoyManoolo/create-my-saas.git"
  },
  "bugs": {
    "url": "https://github.com/SoyManoolo/create-my-saas/issues"
  },
  "homepage": "https://github.com/SoyManoolo/create-my-saas#readme",
  "type": "module",
  "bin": {
    "create-my-saas": "packages/cli/bin/create-my-saas.js"
  },
  "files": [
    "packages/cli",
    "templates",
    "extensions",
    "docs",
    "README.md",
    "!templates/**/.next",
    "!templates/**/.pnpm-store",
    "!templates/**/.pytest_cache",
    "!templates/**/.ruff_cache",
    "!templates/**/.turbo",
    "!templates/**/.uv-validation-cache",
    "!templates/**/.venv",
    "!templates/**/__pycache__",
    "!templates/**/build",
    "!templates/**/coverage",
    "!templates/**/dist",
    "!templates/**/node_modules",
    "!templates/**/*.pyc",
    "!templates/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test packages/cli/test/*.test.js",
    "test:cli": "node --test packages/cli/test/*.test.js",
    "test:e2e:browser": "playwright test",
    "test:e2e:contract": "node scripts/e2e-generated-projects.mjs --backend fastapi --frontend nextjs",
    "test:e2e:generated": "node scripts/e2e-generated-projects.mjs --backend fastapi --frontend nextjs",
    "audit:public": "node scripts/audit-public-repository.mjs",
    "validate:templates": "node scripts/validate-template-manifests.mjs && node scripts/validate-extension-manifests.mjs",
    "validate:extensions": "node scripts/validate-extension-manifests.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
